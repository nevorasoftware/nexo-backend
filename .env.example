# Cadena de conexión de PostgreSQL (en Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://usuario:password@localhost:5432/nexo?schema=public"

# Secreto para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET="cambia-esto-por-un-secreto-largo"

# Puerto (Railway lo inyecta automáticamente)
PORT=3000

# Opcional: orígenes permitidos para CORS, separados por coma
# CORS_ORIGIN="https://nexo-frontend-production.up.railway.app"
