{
  "name": "nexo-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de Nexo - gestión de ventas, servicios e inventario para salones de belleza",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate",
    "start": "prisma migrate deploy && node src/index.js",
